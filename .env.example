# Copiado para .env pelo servidor/instalar.sh, que já gera a senha. Não versionar o .env.
# Senha do usuário "vagas" no PostgreSQL (use a mesma na credencial Postgres do n8n).
# Mude só antes da primeira subida: depois o banco já foi criado com ela.
POSTGRES_PASSWORD=

# Gravados pelo servidor/configurar_n8n.sh (não precisa preencher à mão). O token também
# fica na credencial do n8n; aqui ele serve ao container telegram, que lê os comandos.
TELEGRAM_CHAT_ID=
TELEGRAM_TOKEN=

# Gerado pelo servidor/configurar_n8n.sh: segredo que o container telegram manda ao webhook
# de comandos do n8n (cabeçalho X-Bot-Vagas-Segredo). Sem ele, o n8n recusa os comandos.
N8N_COMANDO_SEGREDO=
